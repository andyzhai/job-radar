{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "profile": "tsx collector/commands/open-bot-profile.ts",
    "inspect": "tsx collector/commands/inspect-source.ts",
    "collect": "tsx collector/commands/run-collection.ts",
    "db:init": "tsx collector/commands/initialize-database.ts",
    "build": "vite build",
    "start": "tsx server/start-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 collector/tests/*.test.ts server/tests/*.test.ts",
    "test:ui": "tsx --test ui/tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:ui"
  },
  "dependencies": {
    "cloakbrowser": "0.7.0",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
